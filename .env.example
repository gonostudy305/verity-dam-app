# ==============================================================================
# VerityDAM Environment Configuration Template
# ==============================================================================

# Database: PostgreSQL 16+ with pgvector
DATABASE_URL=postgresql://verity:verity_dev_only@localhost:5432/verity_dam

# Next.js & Better Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-server-secret
VERITY_TRUSTED_ORIGINS=http://localhost:3000

# Enterprise SSO (OIDC / Zitadel / Keycloak / Google / GitHub) - Optional
VERITY_SSO_ENABLED=false
VERITY_SSO_ISSUER=https://auth.example.com
VERITY_SSO_CLIENT_ID=
VERITY_SSO_CLIENT_SECRET=

# S3 / Cloudflare R2 Object Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-storage-access-key-id
R2_SECRET_ACCESS_KEY=your-storage-secret-access-key
R2_BUCKET=verity-dam
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://assets.example.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.example.com

# MCP Server Settings
VERITY_MCP_EMAIL=mcp-agent@veritydam.internal
VERITY_MCP_USER_ID=
VERITY_INTERNAL_SERVICE_KEY=replace-with-internal-service-key
VERITY_VISION_CONFIG_MASTER_KEY=base64-encoded-32-byte-random-secret
AI_VISION_RATE_LIMIT_PER_MINUTE=20

# Vision Embedding Models
VERITY_EMBEDDING_PROFILE=local_siglip2
VERITY_EMBEDDING_PROVIDER=local_siglip2
VERITY_EMBEDDING_MODEL=siglip2-b32-256-webli
VERITY_EMBEDDING_VERSION=v1
VERITY_EMBEDDING_DIMENSION=768
VERITY_SIGLIP2_VISION_MODEL_PATH=/app/models/siglip2-vision-opset18.onnx
VERITY_SIGLIP2_TEXT_MODEL_PATH=/app/models/siglip2-text-opset18.onnx
VERITY_SIGLIP2_SPACE_ID=verity-siglip2-b32-256-webli-v1
